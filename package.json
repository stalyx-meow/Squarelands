{
  "name": "squarelands",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "方域 · 多人城市经营与贸易游戏",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "desktop": "node scripts/run-godot.mjs",
    "server:app": "electron electron/server-main.cjs",
    "test": "node --test --test-concurrency=1",
    "check": "node scripts/check.mjs",
    "icons": "node scripts/icons.mjs",
    "pack": "node scripts/package.mjs all",
    "pack:client": "node scripts/package-godot.mjs",
    "pack:server": "node scripts/package.mjs server",
    "pack:all": "npm run pack:server && npm run pack:godot",
    "checksums": "node scripts/checksums.mjs",
    "pack:update": "node scripts/package-update.mjs",
    "desktop:web": "electron .",
    "pack:godot": "node scripts/package-godot.mjs",
    "test:godot": "node scripts/godot-smoke.mjs",
    "check:godot": "node scripts/check-godot.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "electron": "42.11.16",
    "electron-builder": "26.15.3"
  },
  "author": "Squarelands contributors",
  "license": "MIT"
}
